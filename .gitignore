# Raw broker documents must never be committed — they carry account numbers,
# names, tax ids and balances. Only redacted derivatives belong in docs/samples.
# See docs/samples/equity-sources-findings.md.
TC_*.pdf
*_soa*.pdf
# Belt-and-braces: no raw PDF (Stockbit TC or otherwise) ever enters the repo.
# Only redacted, extracted-text derivatives belong in docs/samples (SPEC §4.2).
*.pdf
ibkr-flex.xml
ibkr-nav.xml
.env
.DS_Store
ibkr-flex-sample.xml
# testing
/coverage
.claude/settings.local.json
.claude/worktrees/
.claude/skills/

# Build skeleton
node_modules/
*.db
*.db-journal
*.db-wal
*.db-shm
deploy/**/logs/
__pycache__/
*.pyc

# Durability tiers (SPEC §13.5, #39). DB snapshots are *.db (ignored above); the
# raw archive is PII-bearing (names, NPWP/NIK, account numbers) and stays local
# or encrypted — it must never enter the repo. These are the default local
# directory names; $JOURNAL_SNAPSHOTS_DIR / $JOURNAL_ARCHIVE_DIR / $JOURNAL_OFFSITE_DIR
# point them at a durable, ideally encrypted, volume.
snapshots/
archive/
offsite/

# The job runtime (yfinance); created by `python3 -m venv .venv`.
.venv/
